# Copy to backend/.env and adjust.
SECRET_KEY=change-me-to-a-long-random-string
# Optional dedicated Fernet key (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=
ANONYMIZATION_SALT=change-me-too
# SQLite by default; PostgreSQL example: postgresql+psycopg2://eduskills:eduskills@localhost:5432/eduskills
# DATABASE_URL=sqlite:///./data/eduskills.db
# Generative AI. Leave AI_API_KEY empty to use the local fallback engine.
# Google AI Studio (Gemini) - get a key at https://aistudio.google.com/apikey
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.5-flash
# OpenAI instead:
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
SEED_DEMO_DATA=true
